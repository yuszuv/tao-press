#!/usr/bin/env ruby

require "bundler/setup"
require "dotenv/load"
require "dry/cli"
require "dry/monads"
require "dry/monitor"
require "dry/events"

require_relative "../system/container"
require_relative "../system/import"
require_relative "../system/log_decorator"
require_relative "../lib/tao_press/version"
require_relative "../lib/support/table_printer"
require_relative "../lib/support/vcr"

require "pry" if Application.env == :development

module TaoPress
  module CLI
    module Commands
      extend Dry::CLI::Registry
      # Base class for CLI commands that need access to the container
      class Base < Dry::CLI::Command
        include Dry::Monads[:result]

        attr_reader :app, :logger, :settings

        def initialize
          super
          bootstrap_application unless Application.finalized?
          @app = Application
          @logger = Application['logger']
          @settings = Application['settings']
        end

        private

        def bootstrap_application
          # Application.configure!

          Application.finalize!
        end
      end

      class ExportNews < Base
        SECTION_SEP = "=" * 80

        desc "Export news from Contao to CSV and Markdown formats"

        option :limit, type: :integer, desc: "Limit number of news items to export"
        option :output, type: :string, desc: "Override CSV output path", aliases: ["-o"]
        option :markdown_output, type: :string, desc: "Override Markdown output directory", aliases: ["-m"]
        option :tags, type: :boolean, default: false, desc: "Regenerate the tags"

        example [
          "              # Export all news items",
          "--limit=10    # Export only first 10 news items",
          "--output=/tmp/news.csv # Export CSV to custom path",
          "--markdown_output=/tmp/markdown # Export Markdown to custom directory"
        ]

        def call(**options)
          record = options[:tags] ? :all : :none

          VCR.use_cassette("openai", record:) do
            logger.info "Starting news export..."
            logger.info ""

            csv_path = options[:output] || settings.csv_output_path
            markdown_path = options[:markdown_output] || settings.markdown_output_path
            limit = options[:limit]

            command = app["commands.export_news"]

            res = command.(csv_path:, markdown_path:, limit:)

            case res
            in Success(result)
            logger.info "Overall result"
            logger.info SECTION_SEP
            logger.info TablePrinter.print_row(
              result,
              [:processed_count, :failures, :csv_file, :markdown_dir]
            )

            # if failures.any?
            #   $stdout.print "Show invalid data? (y/N) "
            #   dec = $stdin.gets.chomp
            #   unless dec == "" || dec.downcase == "n"
            #     logger.ap failures, :info
            #   end
            # end
            in Failure[:invalid_data, { error:, data: }]
            logger.info "Invalid data found ..."
            logger.info error.message
            logger.info ""
            $stdout.print "Show invalid data? (y/N) "
            dec = $stdin.gets.chomp
            unless dec == "" || dec.downcase == "n"
              logger.ap data.slice(:headline), :info
            end
            in Failure[code, *payload]
            logger.info("something expectable happend")
            logger.info "code: #{code}"
            logger.info "payload:"
            logger.info payload.inspect
          else
            logger.info("Something unexpected happend.")
            logger.info("Some guy called 'your system administrator' has been informed.")
          end
          rescue => e
            puts "something went wrong"
            puts e.class
            puts e
            raise e
          end
        end

        def bootstrap_application
          setup_logging
          super
        end

        def setup_logging
          Application.prepare(:fs)
          Application.after(:register) do |key|
            logger = resolve(:logger)
            csv_reader = resolve(:csv_reader)

            case key
            when "repositories.news_repo"
              decorate(key, with: LogDecorator.for(:listing) do |result|
                logger.debug "\nListing Result:"
                logger.debug SECTION_SEP
                logger.debug "Count: #{result.count}"
                logger.debug ""
              end)
            when "mappers.news_mapper"
              decorate(key, with: LogDecorator.for(:call) do |result|
                logger.debug "\nMapper Result:"
                logger.debug SECTION_SEP
                logger.ap result, :debug
                logger.debug ""
              end)
            when "serializers.csv_serializer"
              decorate(key, with: LogDecorator.for(:call) do |result|
                logger.debug("CSV Serializer result:")
                logger.debug SECTION_SEP
                csv_reader.(result.path) do |row|
                  logger.debug TablePrinter.print_row(row, ["title", "excerpt"])
                end
              end)
            when "serializers.markdown_serializer"
              decorate(key, with: LogDecorator.for(:call) do |result|
                logger.debug("Markdown Serializer result:")
                logger.debug SECTION_SEP
                logger.debug "Output directory: #{result}"
              end)
            when "services.tag_extractor"
              decorate(key, with: LogDecorator.for(:call) do |result|
                logger.debug("Tag extractor result:")
                logger.debug SECTION_SEP
                logger.debug "#{result}"
              end)
            #   wait(result).tap { logger.info ' done' }
            end
          end
        end
      end

      class Info < Base
        desc "Show application information and available components"

        def call(*)
          puts "\n" + "=" * 60
          puts "TaoPress Application Info"
          puts "=" * 60
          puts "\nRegistered Components:"
          Application.keys.sort.each do |key|
            puts "  • #{key}"
          end
          puts "\nAutoloader: #{Application.autoloader.class}"
          puts "Environment: #{Application.config.env}"
          puts "=" * 60
          puts
        end
      end

      class Version < Dry::CLI::Command
        desc "Print version"

        def call(*)
          puts TaoPress::VERSION
        end
      end

      # Register commands
      register "export", ExportNews, aliases: ["e"]
      register "info", Info
      register "version", Version, aliases: ["v", "-v", "--version"]
    end

  end
end

# Run the CLI
begin
  Dry::CLI.new(TaoPress::CLI::Commands).call
rescue Dry::System::ProviderSources::Settings::InvalidSettingsError, Application::ArgumentError => e
  puts e.backtrace
  puts
  puts "-" * 50
  puts
  puts e.message
  puts
  puts "-" * 50
  puts
  puts "invalid settings: please revise your setup, see .env and ./system/provider/settings"
end
