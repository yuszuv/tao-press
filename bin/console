#!/usr/bin/env ruby

# # Optionales Reload (einfach): nutzt Zeitwerk, wenn vorhanden
def reload!
  begin
    require "zeitwerk"
    @__loader__ ||= Zeitwerk::Loader.new.tap do |l|
      l.push_dir(File.expand_path("../lib", __dir__))
      l.enable_reloading
      l.setup
    end
    @__loader__.reload
    puts "reloaded."
  rescue LoadError
    puts "Zeitwerk nicht verfügbar – Konsole neu starten zum Reload."
  end
  true
end

begin
  require "bundler/setup"
  require "pry"
  require_relative "../system/container"
  require_relative "../system/import"
  require_relative "../lib/support/vcr"

  VCR.use_cassette("openai") do
    # Boots
    Application.finalize!

    app = Application
    settings = app["settings"]

    command = app["commands.export_news"]

    binding.pry
  end
rescue
  puts "rescuing ..."
end

